{
  "name": "foo-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "tsx --test src/*.test.ts scripts/*.test.mjs",
    "docs:sync": "node scripts/sync-agent-docs.mjs",
    "docs:check": "node scripts/sync-agent-docs.mjs --check",
    "doctor": "node scripts/mainbrella-doctor.mjs",
    "verify:agent": "node scripts/mainbrella-verify.mjs",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.1.4",
    "wrangler": "^4.128.0"
  },
  "dependencies": {
    "@stripe/stripe-js": "^9.17.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  }
}
